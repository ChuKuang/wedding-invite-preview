.page { padding: 20rpx 32rpx 240rpx; }

/* 身份卡 */
.status { border-radius: var(--r); padding: 32rpx 36rpx; margin-bottom: 28rpx; }
.status.ok { background: var(--cream); }
.status.no { background: var(--card); border: 1rpx solid var(--line); }
.s-t { font-family: var(--serif); font-size: 32rpx; color: var(--ink); font-weight: 600; }
.s-d { margin-top: 12rpx; font-size: 23rpx; line-height: 1.8; color: var(--ink-2); }
.s-id {
  margin-top: 18rpx; font-size: 21rpx; color: var(--ink-3);
  word-break: break-all; line-height: 1.7;
}
.mono { font-family: 'SFMono-Regular', Consolas, monospace; font-size: 21rpx; }
.acts { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btn.sm { height: 76rpx; font-size: 26rpx; flex: 1; }
.btn.sm.ghost { background: #fff; color: var(--ink-2); border-color: var(--line); }

/* 分区 */
.tabs { white-space: nowrap; margin-bottom: 24rpx; }
.tw { display: inline-flex; gap: 14rpx; }
.t {
  padding: 14rpx 30rpx; border-radius: 6rpx; background: #fff;
  font-size: 25rpx; color: var(--ink-2); letter-spacing: .06em;
}
.t.on { background: var(--sun-dp); color: #FFF9F3; font-weight: 600; }

/* 表单 */
.grp {
  background: var(--card); border-radius: var(--r);
  padding: 32rpx 32rpx 16rpx; margin-bottom: 24rpx; box-shadow: var(--sh-s);
}
.g-t {
  font-family: var(--serif); font-size: 28rpx; color: var(--ink);
  letter-spacing: .08em; margin-bottom: 20rpx; font-weight: 600;
}
.f { margin-bottom: 28rpx; }
.f-l { font-size: 22rpx; color: var(--ink-2); letter-spacing: .06em; margin-bottom: 12rpx; }
.f-i {
  width: 100%; min-height: 76rpx; border: 1rpx solid var(--line);
  border-radius: 8rpx; background: #fff; padding: 16rpx 24rpx;
  font-size: 26rpx; color: var(--ink);
}
.f-a { min-height: 120rpx; line-height: 1.8; }
.f-p { display: flex; gap: 14rpx; }
.f-p .f-i { flex: 1; }
.up {
  flex-shrink: 0; padding: 0 28rpx; height: 76rpx; border-radius: 20rpx;
  background: var(--cream); color: var(--sun-dp); font-size: 25rpx;
  display: flex; align-items: center; letter-spacing: .06em;
}
.f-h { margin-top: 10rpx; font-size: 20rpx; line-height: 1.7; color: var(--ink-3); }
.au-acts { display: flex; gap: 14rpx; margin-top: 14rpx; }
.au-acts .up { flex: 1; justify-content: center; }
.up.off { background: #fff; color: var(--ink-2); border: 1rpx solid var(--line); }
.f-ph { color: var(--ink-3); font-size: 24rpx; }

/* 相册 */
.trip { padding: 24rpx 0; border-bottom: 1rpx dashed var(--line); }
.trip:last-child { border: 0; }
.trip .f-i, .trip .f-a { margin-bottom: 14rpx; }
.th { display: flex; justify-content: space-between; margin-bottom: 14rpx; }
.tn { font-size: 23rpx; color: var(--ink-2); letter-spacing: .06em; }
.del { font-size: 23rpx; color: var(--sun-dp); }
.add {
  margin: 20rpx 0 12rpx; text-align: center; padding: 22rpx;
  border-radius: 20rpx; background: var(--cream); color: var(--sun-dp);
  font-size: 26rpx; letter-spacing: .1em;
}

/* 统计 */
.stat { display: flex; flex-wrap: wrap; margin-bottom: 20rpx; }
.si {
  width: 50%; padding: 20rpx 0; text-align: center;
  display: flex; flex-direction: column; gap: 8rpx;
}
.sn { font-family: var(--serif); font-size: 48rpx; color: var(--sun-dp); font-weight: 600; }
.sl { font-size: 21rpx; color: var(--ink-3); letter-spacing: .08em; }
.exps { display: flex; gap: 14rpx; }
.exps .exp { flex: 1; }
.exp.off { background: #fff; color: var(--ink-2); border: 1rpx solid var(--line); }
.exp-h { margin-top: 14rpx; font-size: 20rpx; line-height: 1.7; color: var(--ink-3); }
.exp {
  text-align: center; padding: 22rpx; border-radius: 8rpx;
  background: var(--cream); color: var(--sun-dp); font-size: 25rpx; letter-spacing: .06em;
}

/* 回执条目 */
.ri { padding: 22rpx 0; border-bottom: 1rpx dashed var(--line); }
.ri:last-child { border: 0; }
.rh { display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap; }
.tag {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; letter-spacing: .06em;
}
.tag.y { background: var(--cream); color: var(--sun-dp); }
.tag.n { background: #F2EFEA; color: var(--ink-3); }
.rn { font-size: 27rpx; color: var(--ink); font-weight: 600; }
.rc { font-size: 23rpx; color: var(--sun-dp); }
.rt { margin-left: auto; font-size: 20rpx; color: var(--ink-3); }
.rm { margin-top: 10rpx; font-size: 23rpx; color: var(--ink-2); word-break: break-all; }
.rw {
  margin-top: 12rpx; font-size: 25rpx; line-height: 1.9; color: #5C4A40;
  background: var(--cream); border-radius: 18rpx; padding: 16rpx 20rpx;
}
.empty { padding: 60rpx 0; text-align: center; color: var(--ink-3); font-size: 25rpx; }

/* 底部 */
.bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  display: flex; gap: 20rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(246,240,228,.96); border-top: 1rpx solid var(--line);
}
.b-back {
  width: 160rpx; height: 92rpx; border-radius: 8rpx; background: #fff;
  color: var(--ink-2); font-size: 27rpx; display: flex; align-items: center;
  justify-content: center; letter-spacing: .08em;
}
.b-save {
  flex: 1; height: 92rpx; border-radius: 8rpx; background: var(--sun-dp);
  color: #FFF9F3; font-family: var(--serif); font-size: 30rpx; letter-spacing: .14em;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(163,51,40,.2);
}
.b-save.off { background: var(--ink-3); box-shadow: none; }
