.cover {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  display: flex; flex-direction: column; justify-content: flex-end;
  background: #2A1A16;
}
.cover-bg { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.cover-bg > image { width: 100%; height: 100%; }

/* 金线框：外粗内细 */
.border {
  position: absolute; left: 28rpx; right: 28rpx; top: 28rpx; bottom: 28rpx; z-index: 2;
  border: 1rpx solid rgba(214, 186, 132, .55);
  pointer-events: none;
}
.border::after {
  content: ''; position: absolute; left: 10rpx; right: 10rpx; top: 10rpx; bottom: 10rpx;
  border: 1rpx solid rgba(214, 186, 132, .28);
}

.in {
  position: relative; z-index: 3;
  padding: 0 70rpx 250rpx; text-align: center;
}
.kicker {
  font-size: 24rpx; letter-spacing: .6em; text-indent: .6em;
  color: rgba(248, 239, 228, .82); margin-bottom: 40rpx;
}

/* 竖排姓名 */
.names {
  display: flex; align-items: center; justify-content: center; gap: 44rpx;
  color: #F8EFE4; font-weight: 600;
}
.vname {
  writing-mode: vertical-rl;
  font-size: 72rpx; letter-spacing: .28em; line-height: 1;
  text-shadow: 0 4rpx 36rpx rgba(40, 14, 10, .45);
}
.names .seal { box-shadow: inset 0 0 0 7rpx var(--sun-dp), inset 0 0 0 9rpx rgba(248, 239, 228, .8), 0 6rpx 24rpx rgba(30, 8, 6, .35); }

.line {
  display: flex; align-items: center; justify-content: center; gap: 18rpx;
  margin: 48rpx auto 34rpx;
}
.line .ln { width: 72rpx; height: 1rpx; background: rgba(214, 186, 132, .7); }
.line .dia { width: 9rpx; height: 9rpx; background: rgba(214, 186, 132, .9); transform: rotate(45deg); }

.date {
  font-size: 32rpx; letter-spacing: .22em; text-indent: .22em;
  color: rgba(248, 239, 228, .95);
}
.lunar {
  margin-top: 12rpx; font-size: 22rpx; letter-spacing: .3em; text-indent: .3em;
  color: rgba(248, 239, 228, .7);
}
.place {
  margin-top: 10rpx; font-size: 22rpx; letter-spacing: .3em; text-indent: .3em;
  color: rgba(248, 239, 228, .7);
}
.words {
  margin: 48rpx auto 0; max-width: 620rpx;
  font-size: 25rpx; line-height: 2.1; letter-spacing: .06em;
  color: rgba(248, 239, 228, .86);
}

.hint {
  position: absolute; left: 0; right: 0; bottom: 110rpx; z-index: 4;
  display: flex; justify-content: center;
}
.pill {
  padding: 18rpx 48rpx; border-radius: 4rpx;
  background: rgba(163, 51, 40, .55);
  border: 1rpx solid rgba(214, 186, 132, .7);
  font-size: 24rpx; letter-spacing: .4em; text-indent: .4em;
  color: #F8EFE4;
  animation: breathe 2.8s ease-in-out infinite;
}
@keyframes breathe {
  0%, 100% { transform: translateY(0); opacity: .85; }
  50%      { transform: translateY(-8rpx); opacity: 1; }
}

.v {
  position: absolute; left: 0; right: 0; bottom: 54rpx; z-index: 5;
  text-align: center; font-size: 20rpx; letter-spacing: .1em;
  color: rgba(255, 255, 255, .18);
}
