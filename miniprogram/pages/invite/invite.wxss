.page { padding: 0 40rpx 40rpx; }

.hero {
  position: relative;
  height: 540rpx;
  margin: 0 -40rpx;
  border-radius: 0;
}
.hero-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 0 48rpx 44rpx; z-index: 4; }
.ht {
  display: flex; align-items: center; gap: 18rpx;
  font-family: var(--serif); font-size: 24rpx;
  letter-spacing: .34em; color: rgba(255,255,255,.9);
}
.ht i { display: block; width: 32rpx; height: 1rpx; background: rgba(255,255,255,.55); }
.hn {
  margin-top: 24rpx; font-size: 52rpx; color: #fff; letter-spacing: .1em;
  letter-spacing: .24em; text-shadow: 0 4rpx 32rpx rgba(40,20,14,.45);
}

/* 信 */
.letter {
  position: relative; z-index: 6;
  margin-top: -36rpx;
  background: var(--card);
  border-radius: var(--r);
  padding: 64rpx 56rpx 56rpx;
  box-shadow: var(--sh-m);
}
.hi { font-size: 31rpx; color: var(--ink); letter-spacing: .12em; margin-bottom: 30rpx; font-weight: 600; }
.p {
  font-size: 28rpx; line-height: 2.2; color: #4A3F39;
  letter-spacing: .05em; text-indent: 2em; margin-bottom: 6rpx;
}
.sign-row {
  margin-top: 44rpx; display: flex; align-items: flex-end; justify-content: space-between;
}
.sign-r { display: flex; align-items: center; gap: 14rpx; }
.sign-img { height: 88rpx; width: 250rpx; }
.sign-img.big { width: 300rpx; height: auto; margin: 0 auto; }
.sdate { font-size: 23rpx; color: var(--ink-2); letter-spacing: .08em; white-space: nowrap; }

/* 日期时间 */
.dt {
  display: flex; margin: 32rpx 0;
  background: var(--card); border-radius: var(--r);
  padding: 36rpx 0; border: 1rpx solid var(--line); box-shadow: var(--sh-s);
}
.col { flex: 1; text-align: center; position: relative; }
.col + .col::before {
  content: ''; position: absolute; left: 0; top: 12rpx; bottom: 12rpx;
  width: 1rpx; background: var(--gold); opacity: .45;
}
.k { font-size: 21rpx; letter-spacing: .4em; text-indent: .4em; color: var(--gold); font-family: var(--serif); }
.v {
  margin-top: 16rpx; font-size: 40rpx; color: var(--ink);
  letter-spacing: .03em; font-weight: 600;
}
.v .s {
  display: block; margin-top: 10rpx;
  font-size: 23rpx; color: var(--ink-2); letter-spacing: .1em; font-weight: 400;
}

/* 流程 */
.sched { padding: 16rpx 40rpx; }
.row {
  display: flex; align-items: center; gap: 28rpx;
  padding: 24rpx 0; border-bottom: 1rpx solid var(--line);
}
.row:last-child { border: 0; }
.t { font-family: var(--serif); font-size: 30rpx; color: var(--sun-dp); width: 104rpx; font-weight: 600; }
.d { font-size: 26rpx; color: var(--ink); letter-spacing: .04em; }
.d .n { color: var(--ink-3); font-size: 22rpx; margin-left: 12rpx; }

/* 地点 */
.place { margin-top: 28rpx; border-radius: var(--r); overflow: hidden; background: var(--card); border: 1rpx solid var(--line); box-shadow: var(--sh-s); }
.place-pic { height: 236rpx; }
.over {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 3;
  display: flex; align-items: baseline; padding: 0 36rpx 28rpx;
}
.over .b { font-size: 34rpx; color: #fff; letter-spacing: .2em; font-weight: 600; text-shadow: 0 2rpx 24rpx rgba(0,0,0,.3); }
.over .h { font-size: 22rpx; color: rgba(255,255,255,.8); margin-left: 20rpx; letter-spacing: .06em; }
.place-b { padding: 32rpx 36rpx 36rpx; }
.addr { font-size: 25rpx; line-height: 1.9; color: var(--ink-2); letter-spacing: .03em; white-space: pre-line; }
.acts { display: flex; gap: 20rpx; margin-top: 28rpx; }
.acts .btn { flex: 1; height: 88rpx; font-size: 28rpx; }

/* 注意 */
.note { margin-top: 28rpx; }
.li { font-size: 24rpx; line-height: 1.95; color: var(--ink-2); letter-spacing: .03em; }

/* 落款 */
.foot { margin: 56rpx 0 8rpx; text-align: center; }
.fs { margin-top: 16rpx; font-size: 21rpx; letter-spacing: .16em; color: var(--ink-2); }
.to-rsvp {
  margin-top: 32rpx; display: inline-block;
  font-family: var(--serif); font-size: 26rpx; letter-spacing: .2em;
  color: var(--sun-dp); padding: 14rpx 36rpx; border: 1rpx solid var(--sun-dp); border-radius: 4rpx;
}
