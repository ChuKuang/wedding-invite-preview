.page { padding: 16rpx 40rpx 40rpx; }

.hero { height: 236rpx; border-radius: var(--r); margin-bottom: 36rpx; }
.txt { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding: 0 40rpx 34rpx; }
.t1 { font-size: 34rpx; color: #fff; letter-spacing: .2em; text-shadow: 0 4rpx 28rpx rgba(0,0,0,.35); }
.t2 { margin-top: 12rpx; font-size: 22rpx; color: rgba(255,255,255,.82); letter-spacing: .14em; }

.field { margin-bottom: 40rpx; }

/* 问句 */
.qa {
  display: flex; align-items: center; gap: 18rpx;
  font-size: 34rpx; color: var(--ink); letter-spacing: .16em; margin-bottom: 26rpx;
}
.qa i { display: block; width: 10rpx; height: 10rpx; background: var(--sun-dp); transform: rotate(45deg); }

/* 主选项：大卡片 */
.opts { display: flex; gap: 22rpx; }
.opt {
  flex: 1; border-radius: var(--r); border: 1rpx solid var(--line); background: var(--card);
  padding: 36rpx 24rpx 32rpx; display: flex; flex-direction: column; align-items: center;
  gap: 14rpx; text-align: center; transition: .22s;
}
.opt.on { border-color: var(--sun-dp); background: var(--cream); box-shadow: inset 0 0 0 1rpx var(--sun-dp); }
.opt .oi { width: 60rpx; height: 60rpx; }
.ob { display: block; font-size: 30rpx; letter-spacing: .14em; color: var(--ink); font-weight: 600; }
.os { display: block; font-size: 22rpx; letter-spacing: .06em; color: var(--ink-3); }
.opt.on .ob { color: var(--sun-dp); }
.opt.on .os { color: var(--ink-2); }

/* 人数 */
.who { display: flex; gap: 14rpx; }
.w {
  flex: 1; border-radius: var(--r); border: 1rpx solid var(--line); background: var(--card);
  padding: 24rpx 4rpx 20rpx; display: flex; flex-direction: column; align-items: center;
  gap: 14rpx; transition: .2s;
}
.w.on { border-color: var(--sun-dp); background: var(--cream); box-shadow: inset 0 0 0 1rpx var(--sun-dp); }
.wi { width: 76rpx; height: 56rpx; }
.w text { font-size: 21rpx; letter-spacing: .02em; color: var(--ink-2); white-space: nowrap; }
.w.on text { color: var(--sun-dp); font-weight: 600; }

/* 输入 */
.lb { font-size: 22rpx; letter-spacing: .22em; color: var(--ink-2); margin-bottom: 18rpx; }
.lb .req { color: var(--sun-dp); }
.lb .lo { color: var(--ink-3); letter-spacing: .06em; margin-left: 10rpx; }
.ipt {
  width: 100%; height: 96rpx; border: 1rpx solid var(--line); border-radius: var(--r);
  background: var(--card); padding: 0 32rpx; font-size: 28rpx; color: var(--ink);
}
.ipt.area { height: 184rpx; padding: 28rpx 32rpx; line-height: 1.85; }
.ph { color: var(--ink-3); font-size: 26rpx; }
.hintline { margin-top: 16rpx; font-size: 21rpx; color: var(--ink-3); letter-spacing: .04em; }
.counter { margin-top: 12rpx; text-align: right; font-size: 21rpx; color: var(--ink-3); }

/* 温柔告知 */
.warm-note {
  background: var(--cream); border-radius: var(--r); padding: 34rpx 36rpx; margin-bottom: 40rpx; border-left: 4rpx solid var(--sun-dp);
  font-size: 26rpx; line-height: 2; color: var(--ink-2); letter-spacing: .05em;
}
.warm-note .k { color: var(--sun-dp); }

.submit { margin-top: 8rpx; }
.tip {
  margin-top: 26rpx; font-size: 22rpx; line-height: 1.95;
  color: var(--ink-3); text-align: center; letter-spacing: .03em;
}

/* 回执卡 */
.done { padding: 68rpx 8rpx 0; text-align: center; animation: up .5s cubic-bezier(.22,.8,.3,1); }
@keyframes up { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: none; } }
.done-ico {
  width: 148rpx; height: 148rpx;
  margin: 0 auto 44rpx; display: flex; align-items: center; justify-content: center;
}
.done-ico image { width: 68rpx; height: 68rpx; }
.done-t { font-size: 42rpx; color: var(--ink); letter-spacing: .12em; }
.done-s { margin-top: 28rpx; font-size: 27rpx; line-height: 2; color: var(--ink-2); letter-spacing: .1em; }

.done-card {
  margin-top: 52rpx; background: var(--card); border-radius: var(--r);
  padding: 52rpx 56rpx; box-shadow: var(--sh-m); text-align: left;
}
.dr {
  display: flex; justify-content: space-between; padding: 18rpx 0;
  font-size: 25rpx; color: var(--ink-2); letter-spacing: .04em;
}
.dr + .dr { border-top: 1rpx solid var(--line); }
.dr .b { color: var(--ink); font-weight: 600; }

.sign-img { width: 380rpx; height: 140rpx; margin: 44rpx auto 0; }
.again {
  margin-top: 40rpx; font-size: 23rpx; color: var(--ink-3);
  letter-spacing: .1em; text-decoration: underline; text-underline-offset: 8rpx;
}
