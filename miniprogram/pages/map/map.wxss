.page { padding: 16rpx 40rpx 40rpx; }

.mapwrap { height: 400rpx; border-radius: var(--r); overflow: hidden; margin-bottom: 32rpx; position: relative; }
.map { width: 100%; height: 100%; }
.pin {
  position: absolute; left: 50%; top: 44%;
  transform: translate(-50%, -100%);
  display: flex; flex-direction: column; align-items: center; z-index: 5;
}
.lbl {
  background: var(--card); color: var(--ink);
  font-size: 21rpx; padding: 16rpx 28rpx; border-radius: 6rpx; border: 1rpx solid var(--gold);
  letter-spacing: .06em; box-shadow: var(--sh-m); white-space: nowrap;
}

.addr { display: flex; align-items: flex-start; gap: 24rpx; margin-bottom: 32rpx; }
.addr .t { flex: 1; font-size: 26rpx; line-height: 1.85; color: var(--ink); }
.addr .t .s { display: block; font-size: 23rpx; color: var(--ink-3); margin-top: 10rpx; }
.copy {
  flex-shrink: 0; font-size: 23rpx; color: var(--sun-dp);
  border: 1rpx solid var(--sun-dp); border-radius: 6rpx; padding: 14rpx 26rpx; letter-spacing: .1em;
}

.routes { padding: 12rpx 36rpx; }
.r { display: flex; gap: 26rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }
.r:last-child { border: 0; }
.r .i { width: 76rpx; height: 76rpx; border-radius: var(--r); background: var(--cream); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.r .i image { width: 40rpx; height: 40rpx; }
.rt { font-size: 27rpx; color: var(--ink); letter-spacing: .08em; font-weight: 600; margin-bottom: 10rpx; }
.rd { font-size: 23rpx; line-height: 1.85; color: var(--ink-2); letter-spacing: .02em; }

.nav { margin-top: 36rpx; }
.sub { margin-top: 20rpx; height: 88rpx; font-size: 27rpx; }
