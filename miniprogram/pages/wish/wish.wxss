.page { padding: 16rpx 40rpx 40rpx; }

.hero { height: 264rpx; border-radius: var(--r); margin-bottom: 32rpx; }
.txt { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding: 0 40rpx 34rpx; }
.t1 { font-size: 34rpx; color: #fff; letter-spacing: .2em; text-shadow: 0 4rpx 28rpx rgba(0,0,0,.35); }
.t2 { margin-top: 12rpx; font-size: 22rpx; color: rgba(255,255,255,.82); letter-spacing: .14em; }

.bar {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 30rpx; padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 23rpx; color: var(--ink-2); letter-spacing: .06em;
}
.bar .n { font-family: var(--serif); font-size: 36rpx; color: var(--sun-dp); margin: 0 6rpx; font-weight: 600; }
.bar .go { color: var(--sun-dp); font-weight: 600; letter-spacing: .1em; }

/* 录音条 */
.rec-bar {
  display: flex; align-items: center; gap: 24rpx;
  background: var(--cream); border-radius: var(--r); padding: 28rpx 32rpx; border: 1rpx solid var(--blush);
  margin-bottom: 32rpx; transition: .2s;
}
.rec-bar.rec { background: var(--blush); }
.mic { width: 68rpx; height: 68rpx; border-radius: 50%; background: var(--sun-dp); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.mic image { width: 34rpx; height: 34rpx; }
.rtext { flex: 1; }
.rt { font-family: var(--serif); font-size: 28rpx; color: var(--ink); letter-spacing: .08em; }
.rs { margin-top: 8rpx; font-size: 21rpx; color: var(--ink-2); letter-spacing: .04em; }
.wave { display: flex; align-items: center; gap: 5rpx; height: 40rpx; }
.wave i { display: block; width: 5rpx; border-radius: 3rpx; background: rgba(255,255,255,.85); }

/* 留言卡 */
.list { display: flex; flex-direction: column; gap: 24rpx; }
.wcard { background: var(--card); border-radius: var(--r); padding: 34rpx 36rpx; border: 1rpx solid var(--line); box-shadow: var(--sh-s); }
.h { display: flex; align-items: center; gap: 22rpx; margin-bottom: 22rpx; }
.av { width: 72rpx; height: 72rpx; border-radius: 50%; overflow: hidden; background: var(--cream); }
.av > image { width: 100%; height: 100%; }
.n { font-size: 26rpx; color: var(--ink); letter-spacing: .08em; font-weight: 600; }
.t { margin-top: 6rpx; font-size: 20rpx; color: var(--ink-3); letter-spacing: .05em; }
.c { font-family: var(--serif); font-size: 27rpx; line-height: 2; color: #4A3F39; letter-spacing: .03em; }

/* 语音条 */
.v {
  display: flex; align-items: center; gap: 24rpx;
  background: var(--cream); border-radius: var(--r); padding: 24rpx 32rpx;
}
.play {
  width: 68rpx; height: 68rpx; border-radius: 50%; background: var(--sun-dp);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(163,51,40,.25);
}
.play image { width: 26rpx; height: 30rpx; margin-left: 4rpx; }
.w { flex: 1; display: flex; align-items: center; gap: 6rpx; height: 48rpx; }
.w i { display: block; width: 5rpx; border-radius: 3rpx; background: var(--sun); opacity: .55; }
.dur { font-size: 22rpx; color: var(--ink-2); letter-spacing: .06em; flex-shrink: 0; }
