.page { padding: 16rpx 40rpx 40rpx; }
.head { margin-bottom: 32rpx; }

.hero {
  height: 300rpx; border-radius: var(--r); margin-bottom: 32rpx;
}
.txt { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding: 0 40rpx 36rpx; }
.t1 { letter-spacing: .2em;
  font-size: 34rpx; color: #fff; letter-spacing: .12em;
  text-shadow: 0 4rpx 28rpx rgba(0,0,0,.35);
}
.t2 { margin-top: 12rpx; font-size: 22rpx; color: rgba(255,255,255,.8); letter-spacing: .16em; }

.mm { display: flex; flex-direction: column; gap: 32rpx; }
.mcard { border-radius: var(--r); overflow: hidden; background: var(--card); border: 1rpx solid var(--line); box-shadow: var(--sh-s); }
.mcard .pic { height: 400rpx; }
.mcard .pic > image { width: 100%; height: 100%; }
.b { padding: 28rpx 34rpx 32rpx; }
.loc { font-size: 26rpx; color: var(--sun-dp); letter-spacing: .16em; font-weight: 600; }
.word {
  font-size: 25rpx; line-height: 1.95;
  color: var(--ink-2); letter-spacing: .04em; font-family: var(--serif);
}

.loc + .word { margin-top: 12rpx; }
