.page { padding: 22rpx 40rpx 40rpx; }
.head { margin-bottom: 40rpx; }
.intro { margin: 26rpx auto 0; color: var(--ink-2); font-size: 24rpx; line-height: 1.9; letter-spacing: .06em; text-align: center; }
.moments { display: flex; flex-wrap: wrap; justify-content: center; gap: 36rpx 24rpx; }
.mcard { width: 100%; min-width: 0; }
.mcard.portrait { width: 88%; }
.mcard.paired { width: calc(50% - 12rpx); }
.photo-frame { padding: 10rpx; border: 1rpx solid var(--line); border-radius: 4rpx; background: var(--card); box-shadow: var(--sh-s); }
.featured .photo-frame { padding: 14rpx; box-shadow: 0 8rpx 26rpx rgba(80, 50, 30, .08); }
.mcard .pic { position: relative; height: 0; background: #E9E0D1; border-radius: 2rpx; overflow: hidden; }
.mcard .pic > image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.photo-state { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--ink-2); font-size: 23rpx; letter-spacing: .06em; }
.photo-state.retry { background: #E9E0D1; }
.caption { padding: 18rpx 8rpx 2rpx; }
.caption-head { display: flex; align-items: baseline; gap: 18rpx; }
.photo-number { flex-shrink: 0; font-family: Georgia, serif; font-size: 22rpx; color: var(--gold); letter-spacing: .08em; }
.loc { color: var(--sun-dp); font-size: 25rpx; letter-spacing: .05em; line-height: 1.7; }
.photo-hint { margin-left: auto; font-size: 20rpx; color: var(--ink-3); letter-spacing: .08em; }
.word { margin-top: 10rpx; font-size: 24rpx; line-height: 1.95; color: var(--ink-2); letter-spacing: .025em; }
.paired .caption-head { gap: 10rpx; }
.paired .loc { font-size: 23rpx; }
.chapter { width: 100%; display: flex; align-items: center; justify-content: center; gap: 22rpx; margin: 14rpx 0 0; font-size: 25rpx; letter-spacing: .18em; color: var(--ink-2); }
.fine-line { width: 62rpx; height: 1rpx; background: var(--line); flex-shrink: 0; }
.film { margin-top: 52rpx; }
.film .chapter { margin-bottom: 28rpx; }
.film-frame { height: 0; position: relative; overflow: hidden; background: #5C3C32; border-radius: 6rpx; }
.film-frame > video, .film-cover, .film-cover > image, .film-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.film-shade { background: rgba(34, 21, 16, .3); }
.film-action { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; }
.play-disc { width: 88rpx; height: 88rpx; border: 1rpx solid rgba(255,255,255,.8); border-radius: 50%; background: rgba(255,255,255,.14); display: flex; align-items: center; justify-content: center; }
.play-triangle { width: 0; height: 0; margin-left: 6rpx; border-top: 14rpx solid transparent; border-bottom: 14rpx solid transparent; border-left: 22rpx solid #fff; }
.film-label { color: #fff; font-size: 24rpx; letter-spacing: .12em; }
.film-note { margin-top: 20rpx; text-align: center; font-size: 24rpx; color: var(--ink-2); }
.film-close { margin: 14rpx auto 0; width: 180rpx; padding: 12rpx; text-align: center; color: var(--sun-dp); font-size: 23rpx; }
.empty { padding: 100rpx 0; text-align: center; color: var(--ink-2); }
.ending { margin-top: 66rpx; text-align: center; font-size: 24rpx; letter-spacing: .1em; color: var(--ink-2); }
.ending-mark { margin: 0 auto 20rpx; width: 50rpx; height: 50rpx; line-height: 48rpx; border: 1rpx solid var(--sun-dp); border-radius: 3rpx; color: var(--sun-dp); font-family: var(--serif); font-size: 32rpx; text-indent: .1em; }
