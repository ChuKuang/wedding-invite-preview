<include src="/templates/music.wxml" />
<view class="page">
  <view class="head">
    <view class="sec-title">{{hero.head || '我 们 的 时 光'}}</view>
    <view class="sec-en" wx:if="{{hero.headEn !== ''}}">{{hero.headEn || 'Our Moments'}}</view>
  </view>

  <!-- 头图 -->
  <view class="pic hero">
    <image src="{{hero.photo}}" mode="aspectFill" />
    <view class="veil"></view><view class="shade"></view>
    <view class="txt">
      <view class="t1 serif">{{hero.title}}</view>
      <view class="t2">{{hero.sub}}</view>
    </view>
  </view>

  <!-- 保留照片比例，竖图和横图均完整展示 -->
  <view class="mm">
    <view class="mcard" wx:for="{{trips}}" wx:key="_key">
      <view class="pic" style="padding-top: {{item._ratio}}%;" data-i="{{index}}" bindtap="preview">
        <image src="{{item._photo}}" mode="aspectFit" lazy-load data-i="{{index}}" bindload="photoLoaded" binderror="photoFailed" />
        <view class="photo-state" wx:if="{{!item._loaded && !item._failed}}">照片加载中</view>
        <view class="photo-state retry" wx:if="{{item._failed}}" data-i="{{index}}" catchtap="retryPhoto">加载失败 · 点此重试</view>
      </view>
      <view class="b" wx:if="{{item.loc || item.word}}">
        <view class="loc serif" wx:if="{{item.loc}}">{{item.loc}}</view>
        <view class="word serif" wx:if="{{item.word}}">{{item.word}}</view>
      </view>
    </view>
  </view>

  <view class="pad"></view>
</view>
