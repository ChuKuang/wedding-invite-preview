/* ============================================================
   全局设计令牌 · 新中式版
   宣纸为底、墨色为字、朱砂点睛、细金线收边
   页面里直接用 var(--xxx) 即可
   ============================================================ */
page {
  --warm: #F6F0E4;      /* 宣纸：页面底色 */
  --cream: #F3E4D7;     /* 淡朱：选中态、提示底 */
  --cream-2: #ECDCCB;
  --sun: #B8483A;       /* 朱砂（亮） */
  --sun-dp: #A33328;    /* 朱砂：主强调色 */
  --blush: #E3BFB1;
  --gold: #B4935A;      /* 细金线 */
  --ink: #2F2724;       /* 墨 */
  --ink-2: #6B5F57;
  --ink-3: #A0948A;
  --line: #E6DAC6;
  --card: #FBF8F1;

  --r: 12rpx;
  --sh-s: 0 2rpx 10rpx rgba(80, 50, 30, .05);
  --sh-m: 0 10rpx 28rpx rgba(80, 50, 30, .10);
  --serif: 'Songti SC', 'STSong', 'Noto Serif CJK SC', 'Source Han Serif SC', serif;
  --sans: 'PingFang SC', -apple-system, 'Helvetica Neue', sans-serif;

  background: var(--warm);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 28rpx;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

view, text, image, input, textarea, button { box-sizing: border-box; }
button::after { border: none; }
image { display: block; }

/* ---------- 通用排版 ---------- */
.serif { font-family: var(--serif); }

.sec-title {
  font-family: var(--serif);
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: .3em;
  text-indent: .3em;
  text-align: center;
  color: var(--ink);
}
.sec-en {
  margin-top: 12rpx;
  text-align: center;
  font-family: var(--serif);
  font-size: 19rpx;
  letter-spacing: .42em;
  text-indent: .42em;
  color: var(--gold);
  text-transform: uppercase;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: var(--r);
  padding: 40rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--sh-s);
}

/* ---------- 婚帖双线框：给容器加 frame 类即可 ---------- */
.frame { position: relative; }
.frame::before, .frame::after {
  content: ''; position: absolute; pointer-events: none;
  border: 1rpx solid var(--gold);
}
.frame::before { left: 14rpx; top: 14rpx; right: 14rpx; bottom: 14rpx; opacity: .55; }
.frame::after { left: 22rpx; top: 22rpx; right: 22rpx; bottom: 22rpx; opacity: .28; }

/* ---------- 朱砂印章「囍」 ---------- */
.seal {
  display: inline-flex; align-items: center; justify-content: center;
  width: 76rpx; height: 76rpx; border-radius: 8rpx;
  background: var(--sun-dp); color: #F8EFE4;
  font-family: var(--serif); font-size: 46rpx; line-height: 1; font-weight: 600;
  box-shadow: inset 0 0 0 5rpx var(--sun-dp), inset 0 0 0 7rpx rgba(248, 239, 228, .8);
  flex-shrink: 0;
}
.seal.sm { width: 52rpx; height: 52rpx; font-size: 32rpx; border-radius: 6rpx;
  box-shadow: inset 0 0 0 4rpx var(--sun-dp), inset 0 0 0 5rpx rgba(248, 239, 228, .8); }
.seal.lg { width: 116rpx; height: 116rpx; font-size: 72rpx; border-radius: 12rpx;
  box-shadow: inset 0 0 0 7rpx var(--sun-dp), inset 0 0 0 9rpx rgba(248, 239, 228, .8); }

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 8rpx;
  background: var(--sun-dp);
  color: #F8EFE4;
  font-family: var(--serif);
  font-size: 30rpx;
  letter-spacing: .2em;
  text-indent: .2em;
  box-shadow: 0 8rpx 18rpx rgba(163, 51, 40, .18);
  transition: transform .18s;
}
.btn:active { transform: scale(.975); }
.btn.ghost {
  background: transparent;
  color: var(--sun-dp);
  border: 1rpx solid var(--sun-dp);
  box-shadow: none;
}
.btn.soft {
  background: transparent;
  color: var(--ink);
  border: 1rpx solid var(--ink-3);
  box-shadow: none;
}

/* ---------- 照片容器（统一暖墨调 + 暗角） ---------- */
.pic { position: relative; overflow: hidden; background: #D9CBB5; }
.pic > image { width: 100%; height: 100%; }
.pic .veil {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(165deg, rgba(240,220,190,.10), rgba(163,51,40,.04) 55%, rgba(47,39,36,.24));
}
.pic .shade {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(40,28,24,.26) 0%, rgba(40,28,24,.02) 34%, rgba(36,24,20,.62) 100%);
}

/* ---------- 提示条 ---------- */
.note {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r);
  padding: 34rpx 36rpx;
  font-size: 24rpx;
  line-height: 1.95;
  color: var(--ink-2);
}
.note .k { color: var(--sun-dp); font-weight: 600; }
.note .h {
  display: flex; align-items: center; gap: 16rpx;
  font-family: var(--serif);
  font-size: 27rpx;
  color: var(--ink);
  letter-spacing: .2em;
  margin-bottom: 18rpx;
}
.note .h::before {
  content: ''; width: 10rpx; height: 10rpx; background: var(--sun-dp);
  transform: rotate(45deg); flex-shrink: 0;
}

/* ---------- 分隔：金线 + 朱砂菱 ---------- */
.divider {
  display: flex; align-items: center; justify-content: center;
  gap: 22rpx; margin: 36rpx 0 44rpx;
}
.divider .l { width: 80rpx; height: 1rpx; background: var(--gold); opacity: .6; }
.divider .d {
  width: 10rpx; height: 10rpx; background: var(--sun-dp);
  transform: rotate(45deg);
}

/* ---------- 空态 ---------- */
.empty {
  padding: 90rpx 0;
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
  letter-spacing: .1em;
}

/* ---------- 背景音乐按钮（templates/music.wxml） ---------- */
.bgm {
  position: fixed; right: 28rpx; top: 24rpx; z-index: 50;
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(251, 248, 241, .9);
  box-shadow: 0 4rpx 16rpx rgba(47, 39, 36, .18);
}
.bgm:active { transform: scale(.92); }

/* 唱片：纹路 + 一道斜向反光（转起来才看得出在转） */
.bgm-disc {
  position: relative; width: 52rpx; height: 52rpx; border-radius: 50%;
  background: repeating-radial-gradient(circle, #3A302C 0, #3A302C 2rpx, #2A221F 3rpx, #2A221F 5rpx);
  display: flex; align-items: center; justify-content: center;
  opacity: .5; transition: opacity .3s;
  animation: bgm-spin 5s linear infinite;
  animation-play-state: paused;   /* 关掉时停在当前角度，不会跳回原位 */
}
.bgm-shine {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 50%;
  border: 6rpx solid transparent;
  border-top-color: rgba(255, 240, 220, .28);
  border-right-color: rgba(255, 240, 220, .10);
}
.bgm-label {
  position: relative; width: 18rpx; height: 18rpx; border-radius: 50%;
  background: var(--sun-dp); box-shadow: 0 0 0 2rpx rgba(214, 186, 132, .9);
}
.bgm-label::after {
  content: ''; position: absolute; left: 3rpx; top: 3rpx;
  width: 4rpx; height: 4rpx; border-radius: 50%; background: #F8EFE4;
}

/* 唱臂：支点在右上角，播放时落到唱片上，关闭时抬起 */
.bgm-arm {
  position: absolute; right: 10rpx; top: 6rpx;
  width: 3rpx; height: 32rpx; border-radius: 2rpx; background: var(--ink-2);
  transform-origin: 50% 0; transform: rotate(-18deg);
  transition: transform .45s cubic-bezier(.3, 1.4, .5, 1);
}
.bgm-arm::before {
  content: ''; position: absolute; left: -4rpx; top: -4rpx;
  width: 11rpx; height: 11rpx; border-radius: 50%; background: var(--gold);
}
.bgm-arm::after {
  content: ''; position: absolute; left: -2rpx; bottom: -3rpx;
  width: 7rpx; height: 9rpx; border-radius: 2rpx; background: var(--ink);
}

/* 波纹：播放时一圈圈金线往外扩散 */
.bgm-wave {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 50%;
  border: 2rpx solid var(--gold); opacity: 0; pointer-events: none;
}

.bgm.on .bgm-disc { opacity: 1; animation-play-state: running; }
.bgm.on .bgm-arm { transform: rotate(26deg); }
.bgm.on .bgm-wave { animation: bgm-ripple 2.4s ease-out infinite; }

@keyframes bgm-spin { to { transform: rotate(360deg); } }
@keyframes bgm-ripple {
  0%   { transform: scale(1);   opacity: .7; }
  100% { transform: scale(1.7); opacity: 0; }
}

/* ---------- 底部留白 ---------- */
.pad { height: 40rpx; }
